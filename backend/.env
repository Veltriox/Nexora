# =============================================================================
# Nexora backend — PRODUCTION / SERVER (committed, safe defaults)
# =============================================================================
# Used on the server and as the base config. Secrets can stay empty: Nexora
# auto-generates JWT_SECRET + INTERNAL_API_SECRET into data/.secrets.
#
# Local development: cp .env.local.example .env.local (gitignored) and edit.
# Docker Compose also injects many of these; values here apply to `node` / `bun` / bare metal.
# =============================================================================

# --- Core ---------------------------------------------------------------------

# SQLite database (Prisma). In Docker this is usually file:/app/data/nexora.db
DATABASE_URL="file:./data/nexora.db"

# API port inside the process (compose exposes via nginx, not this port on host)
PORT=8000

# --- Paths (Docker compose sets these; defaults match a git checkout) ---------

DATA_PATH=./data
DEPLOYMENTS_PATH=./deployments
NGINX_CONF_PATH=./nginx-proxy/conf.d
DOCKER_NETWORK=nexora_network

# Host ports published for user apps (avoid Windows Hyper-V reserved ranges)
PORT_RANGE_START=5500
PORT_RANGE_END=5600

# --- Auth (leave empty on server → auto-persist in data/.secrets) -------------

JWT_SECRET=
INTERNAL_API_SECRET=

# Comma-separated browser origins for CORS. Empty = same-host only (recommended
# behind the dashboard nginx on :8080). Set if the UI is on another origin.
CORS_ORIGIN=

# Public URL of the Nexora dashboard (redirects / GitHub return / terminal Origin)
NEXORA_FRONTEND_URL=http://localhost:8080
DOCKLIFT_FRONTEND_URL=http://localhost:8080

# --- Let's Encrypt (nginx-proxy + certbot sidecar) ----------------------------

# Optional override; otherwise Settings → Domain ACME email, or first admin email.
# CERTBOT_EMAIL=you@example.com

# false = real Let's Encrypt certificates (production)
CERTBOT_STAGING=false

LETSENCRYPT_PATH=./nginx-proxy/certbot/conf
CERTBOT_CONTAINER=nexora-certbot

# --- GitHub App (optional env fallback) ---------------------------------------
# Prefer Settings → GitHub “Create App” (stored in DB). Set these only if you
# manage a GitHub App manually outside the UI.
#
# NEXORA_GITHUB_APP_ID=
# NEXORA_GITHUB_CLIENT_ID=
# NEXORA_GITHUB_CLIENT_SECRET=
# NEXORA_GITHUB_PRIVATE_KEY_PATH=./github-app.pem
